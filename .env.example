# Copy to .env.local and adjust for your setup. NEXT_PUBLIC_* vars are inlined at BUILD time,
# so re-run `npm run build` (or restart `npm run dev`) after changing them.

# Public URL of the API, including the /api suffix.
#
#   docker compose (Drop_Node_Backend/docker-compose.yml) publishes the gateway
#   on host port 5010  ->  http://localhost:5010/api
#
#   the legacy all-in-one backend (`npm run dev` in Drop_Node_Backend) listens
#   on port 5000       ->  http://localhost:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5010/api

# Extra hosts (comma-separated) the Next.js image optimizer may fetch product images from.
# NEXT_PUBLIC_IMAGE_HOSTS=cdn.example.com,images.example.net
